# Progetto Supabase "pedibus-vedano" (regione EU)
SUPABASE_PROJECT_REF=hrrdogjoymunfakwduxd
NEXT_PUBLIC_SUPABASE_URL=https://hrrdogjoymunfakwduxd.supabase.co
# Chiave pubblica (anon): va nell'app. La service_role NON va mai nel frontend.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chiave pubblica VAPID: serve all'app per abbonarsi alle push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Auth: OTP via SMS con Twilio (letti da supabase/config.toml con env(...)) ---
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# --- Edge Function invia-avvisi (si caricano con: npx supabase secrets set --env-file .env.functions) ---
# Segreto condiviso col database: lo stesso valore va in impostazioni.invia_avvisi_secret
PEDIBUS_CRON_SECRET=
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pedibus@officinacivica.it
# Twilio per gli SMS degli avvisi (mittente alfanumerico, es. PEDIBUS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=PEDIBUS
